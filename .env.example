# ==========================================
# BLUFF Environment Variables Configuration
# ==========================================

# Database Connection (PostgreSQL)
# Required for persisting users and match records on Vercel / Cloud.
# Compatible with Neon, Supabase, Vercel Postgres, AWS RDS, etc.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/bluff?sslmode=require"

# NextAuth / Auth.js Secret
# Secret key used to encrypt session tokens and JWTs.
# Generate via: `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET="your_generated_random_secret_here"

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI for production: https://your-domain.vercel.app/api/auth/callback/google
# Authorized redirect URI for local dev: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your_google_client_id_here"
AUTH_GOOGLE_SECRET="your_google_client_secret_here"

# GitHub OAuth App Credentials
# Obtain from GitHub Developer Settings: https://github.com/settings/developers
# Authorization callback URL for production: https://your-domain.vercel.app/api/auth/callback/github
# Authorization callback URL for local dev: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your_github_client_id_here"
AUTH_GITHUB_SECRET="your_github_client_secret_here"

# TypeSafe AI Jev API Key (Optional)
# Optional for local development. If omitted or timed out (>1200ms),
# the system automatically and seamlessly falls back to HeuristicDecisionProvider.
TYPESAFE_API_KEY=""

# Jev Rate Limits (Optional)
# Jev calls are quota-limited per identity: signed-in users are keyed by userId,
# guests by a device cookie (bluff_gid). Guests without a cookie fall back to
# their (salted, hashed) IP. A separate aggregate per-IP quota stops guests from
# minting fresh cookies to bypass the device limit, without false-sharing the
# device quota across a corporate WiFi / NAT.
# Daily counters are persisted in the database (JevUsage table); minute windows
# are best-effort in-memory. Exhaustion silently falls back to heuristic.
# Defaults: signed-in 40/min & 600/day; guests 10/min & 100/day per device;
# guest IP aggregate 30/min & 1000/day.
JEV_RATE_LIMIT_PER_MINUTE="40"
JEV_RATE_LIMIT_PER_DAY="600"
JEV_GUEST_RATE_LIMIT_PER_MINUTE="10"
JEV_GUEST_RATE_LIMIT_PER_DAY="100"
JEV_GUEST_IP_RATE_LIMIT_PER_MINUTE="30"
JEV_GUEST_IP_RATE_LIMIT_PER_DAY="1000"

# Optional Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
